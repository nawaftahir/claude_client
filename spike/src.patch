 #define isupper( c )    ( __ctype_b[(int)( c )] & (unsigned short int)_ISupper )
 #define islower( c )    ( __ctype_b[(int)( c )] & (unsigned short int)_ISlower )
 #define isprint( c )    ( __ctype_b[(int)( c )] & (unsigned short int)_ISprint )
+#endif
 
