+Bool SND_IsAliasChannel3D(int channel)
+{
+    switch (channel) {
+    case 1:
+    case 2:
+    case 7:
+    case 8:
+    case 9:
+    case 10:
+        return 0;
+    default:
+        return 1;
+    }
+}
